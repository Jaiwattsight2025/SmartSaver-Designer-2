# Copy to frontend/.env.local. Never commit real keys.

# Maps JavaScript, Geocoding and Solar APIs. Required for the property map and roof lookup.
VITE_GOOGLE_MAPS_API_KEY=

# Insights origin only (no path, query or token). Used for POST /api/designer-handoff/redeem.
# Leave blank until the Insights backend is deployed for this Designer origin.
# A blank value keeps manual bill entry working and does not pretend the handoff is live.
VITE_INSIGHTS_API_BASE=https://wattsight-platform.onrender.com
